# ---------- Connection to Core node ----------
# Option 1 (recommended, same as DEX): gocore IPC via GOCORE_DATADIR
# The viewer calls `gocore attach <ipc-socket> --exec` — no HTTP port needed.
GOCORE_DATADIR=/root/core-mainnet-node

# Option 2 (fallback): HTTP JSON-RPC — only used when IPC socket is not found.
# CORE_RPC_URL=http://127.0.0.1:9545

# Bind port (Nginx reverse-proxies to this)
NFT_VIEWER_PORT=3470

# Limit concurrent upstream JSON-RPC connections (gocore HTTP can drop under burst load)
# RPC_UPSTREAM_MAX_CONCURRENT=4
# RPC_UPSTREAM_RETRIES=3
