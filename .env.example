# Core JSON-RPC (HTTP). Required for /api/rpc — the viewer cannot use gocore IPC.
#
# Same chain as the DEX, but the DEX GUI usually talks to gocore via IPC and may leave
# CORE_RPC_URL empty on the VPS. For this app you still need a reachable JSON-RPC URL:
#   - VPS: run gocore with --http --http.addr 127.0.0.1 --http.port 9545 (see my-memecoin/docs/DEPLOY_VPS.md)
#   - Local: gocore with HTTP, or tunnel (ngrok) to your node's HTTP port
CORE_RPC_URL=http://127.0.0.1:9545

# Bind port (Nginx reverse-proxies to this)
NFT_VIEWER_PORT=3470
